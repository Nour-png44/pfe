"""
PHASE TRAINING — train_model.py
================================
Ce fichier entraîne les modèles XGBoost et Cox.
Il lit l'historique SMS depuis MongoDB,
calcule des statistiques pour chaque numéro de téléphone,
entraîne les modèles, et sauvegarde le résultat dans model.pkl.
"""

# ── Imports ────────────────────────────────────────────────────
import os
import json
import pickle
import warnings
warnings.filterwarnings("ignore")

import numpy  as np
import pandas as pd

from datetime        import datetime
from pymongo         import MongoClient
from lifelines       import CoxPHFitter
from lifelines.utils import concordance_index
from xgboost         import XGBClassifier
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import (accuracy_score, precision_score,
                             recall_score, f1_score,
                             roc_auc_score, classification_report)

# ── Chemins et paramètres ──────────────────────────────────────
MONGO_URI       = "mongodb://localhost:27017"
MONGO_DB        = "easybulk"
MONGO_COL_INPUT = "user_contact"

# Chemin vers le dossier du projet
BASE_DIR   = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
MODEL_PATH = os.path.join(BASE_DIR, "models", "xgboost", "model.pkl")
JSON_PATH  = os.path.join(BASE_DIR, "data", "user_contact.json")
os.makedirs(os.path.dirname(MODEL_PATH), exist_ok=True)

# Statuts DLR considérés comme un succès de livraison
STATUTS_SUCCES = [1, 16]

# Toutes les features utilisées pour entraîner XGBoost
FEATURE_COLS = [
    "total_sms_envoyes",
    "delivery_rate",
    "failure_rate",
    "echecs_consecutifs",
    "jours_depuis_dernier_succes",
    "recency_score",
    "time_decay_score",
    "dernier_statut",
    "dernier_est_succes",
    "jours_depuis_envoi",
    "heure_envoi",
    "jour_semaine",
    "ratio_buffered",
    "ratio_rejected",
    "ratio_undeliverable",
    "is_utf16",
    "cost",
    "p_na_7j",    # sortie Cox
    "p_na_30j",   # sortie Cox
]


# ══════════════════════════════════════════════════════════════
# ÉTAPE 1 — DATA EXTRACTION
# Lire les données depuis MongoDB (ou le fichier JSON)
# ══════════════════════════════════════════════════════════════
def data_extraction():
    print("\n[ÉTAPE 1] Data Extraction")
    print("  → Lecture de l'historique DLR depuis MongoDB")

    records = []

    # Essayer de se connecter à MongoDB
    try:
        client  = MongoClient(MONGO_URI, serverSelectionTimeoutMS=3000)
        client.server_info()  # teste la connexion
        db      = client[MONGO_DB]
        records = list(db[MONGO_COL_INPUT].find({}, {"_id": 0}))
        client.close()
        print(f"  ✅ MongoDB OK — {len(records)} documents lus")

    except Exception:
        # MongoDB non disponible → lire le fichier JSON local
        print("  ⚠️  MongoDB non disponible → lecture du fichier JSON")
        with open(JSON_PATH, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        records.append(json.loads(line))
                    except:
                        continue
        print(f"  ✅ JSON OK — {len(records)} documents lus")

    return records


# ══════════════════════════════════════════════════════════════
# ÉTAPE 2 — DATA CLEANING
# Nettoyer les données et regrouper par numéro
# ══════════════════════════════════════════════════════════════
def data_cleaning(records):
    print("\n[ÉTAPE 2] Data Cleaning")
    print("  → Suppression des données invalides")
    print("  → Regroupement par numéro de téléphone (MSISDN)")

    avant = len(records)

    # Garder uniquement les documents valides
    records = [
        r for r in records
        if r.get("msisdn")                                   # a un numéro
        and isinstance(r.get("status_history"), list)        # a un historique
        and len(r["status_history"]) > 0                     # historique non vide
    ]
    print(f"  Documents avant  : {avant}")
    print(f"  Documents après  : {len(records)} ({avant - len(records)} supprimés)")

    # Regrouper tous les SMS du même numéro ensemble
    # (un numéro peut avoir reçu des SMS de plusieurs campagnes)
    contacts = {}
    for doc in records:
        msisdn = str(doc["msisdn"]).strip()

        if msisdn not in contacts:
            contacts[msisdn] = {
                "msisdn"        : msisdn,
                "encoding"      : doc.get("encoding", "GSM_7BIT"),
                "cost_list"     : [],
                "status_history": [],
                "nb_messages"   : 0,
            }

        contacts[msisdn]["nb_messages"] += 1
        contacts[msisdn]["cost_list"].append(doc.get("cost", 1))
        contacts[msisdn]["status_history"].extend(doc["status_history"])

    print(f"  Numéros uniques  : {len(contacts)}")
    return contacts


# ══════════════════════════════════════════════════════════════
# ÉTAPE 3 — NORMALISATION DES STATUTS
# Garder uniquement les statuts connus et les nommer clairement
# ══════════════════════════════════════════════════════════════
def normalisation_statuts(contacts):
    print("\n[ÉTAPE 3] Normalisation des statuts")
    print("  → Conversion des codes statuts en noms clairs")

    # Table de correspondance code → nom
    STATUTS = {
        1 : "DELIVERED",      # ✅ SMS reçu par le destinataire
        16: "SMSC_ACK",       # ✅ Accepté par le réseau
        8 : "BUFFERED",       # ⏳ Téléphone éteint, SMS en attente
        4 : "REJECTED",       # ❌ Rejeté par l'opérateur
        2 : "UNDELIVERABLE",  # ❌ Numéro invalide ou inexistant
        34: "EXPIRED",        # ❌ Délai dépassé, SMS expiré
    }

    contacts_norm = {}
    compteur = {}  # pour afficher les stats

    for msisdn, data in contacts.items():
        historique_propre = []

        for s in data["status_history"]:
            code = s.get("status")
            date = s.get("status_last_updated_at")

            # Garder uniquement les statuts connus
            if code in STATUTS:
                historique_propre.append({
                    "status"                : int(code),
                    "status_nom"            : STATUTS[code],
                    "status_last_updated_at": date,
                })
                compteur[code] = compteur.get(code, 0) + 1

        # Garder le contact uniquement s'il a au moins 2 statuts
        if len(historique_propre) >= 2:
            contacts_norm[msisdn] = {**data, "status_history": historique_propre}

    # Afficher la distribution
    total = sum(compteur.values())
    print(f"  Contacts valides : {len(contacts_norm)}")
    print(f"  Distribution des statuts :")
    for code, cnt in sorted(compteur.items(), key=lambda x: -x[1]):
        print(f"    {code:>2} {STATUTS[code]:<15} : {cnt:>5}  ({cnt/total*100:.1f}%)")

    return contacts_norm


# ══════════════════════════════════════════════════════════════
# ÉTAPE 4 — FEATURE ENGINEERING
# Calculer les statistiques de chaque numéro de téléphone
# Ce sont ces statistiques que XGBoost et Cox vont utiliser
# ══════════════════════════════════════════════════════════════
def feature_engineering(contacts_norm):
    print("\n[ÉTAPE 4] Feature Engineering")
    print("  → Calcul des statistiques pour chaque numéro")

    NOW = pd.Timestamp(datetime.now())
    lignes = []  # contiendra une ligne par contact

    for msisdn, data in contacts_norm.items():

        # Convertir l'historique en DataFrame pour faire des calculs
        hist = pd.DataFrame(data["status_history"])
        hist["status_last_updated_at"] = pd.to_datetime(
            hist["status_last_updated_at"], errors="coerce"
        )
        hist = hist.dropna(subset=["status_last_updated_at"])
        hist = hist.sort_values("status_last_updated_at").reset_index(drop=True)

        if len(hist) < 2:
            continue

        # Première et dernière date dans l'historique
        t_debut = hist["status_last_updated_at"].iloc[0]
        t_fin   = hist["status_last_updated_at"].iloc[-1]
        duree   = max((t_fin - t_debut).total_seconds() / 60.0, 0.1)

        # F1 — Total SMS envoyés
        # Combien de fois ce numéro a reçu un SMS
        total_sms_envoyes = data["nb_messages"]

        # F2 — Delivery rate (taux de livraison)
        # Proportion de SMS qui ont bien été livrés
        nb_livres     = hist["status"].isin(STATUTS_SUCCES).sum()
        delivery_rate = round(nb_livres / len(hist), 4)

        # F3 — Failure rate (taux d'échec)
        # Proportion de SMS qui n'ont PAS été livrés
        failure_rate = round(1 - delivery_rate, 4)

        # F4 — Échecs consécutifs
        # Combien de SMS d'affilée ont échoué à la FIN de l'historique
        # Exemple : [livré, livré, échec, échec, échec] → 3
        # Si ce nombre est grand, le contact est probablement injoignable
        echecs_consecutifs = 0
        for s in reversed(hist["status"].tolist()):
            if s not in STATUTS_SUCCES:
                echecs_consecutifs += 1
            else:
                break  # on s'arrête dès qu'on trouve un succès

        # F5 — Jours depuis le dernier succès
        # Depuis combien de jours ce numéro n'a pas reçu de SMS avec succès
        # Si très grand (999) → jamais livré ou très longtemps inaccessible
        sms_livres = hist[hist["status"].isin(STATUTS_SUCCES)]
        if len(sms_livres) > 0:
            derniere_livraison = sms_livres["status_last_updated_at"].max()
            jours_depuis_dernier_succes = round(
                (NOW - derniere_livraison).total_seconds() / 86400.0, 2
            )
        else:
            jours_depuis_dernier_succes = 999.0  # jamais livré

        # F6 — Recency score
        # Score entre 0 et 1 :
        #   proche de 1 = dernier succès très récent → contact joignable
        #   proche de 0 = dernier succès très ancien → contact injoignable
        recency_score = round(
            np.exp(-0.1 * jours_depuis_dernier_succes), 6
        )

        # F7 — Time Decay score
        # Somme des succès passés, pondérés par leur ancienneté
        # Un succès d'hier compte PLUS qu'un succès d'il y a 6 mois
        # Formule : Σ exp(-0.1 × jours) pour chaque SMS livré
        time_decay_score = 0.0
        for _, row in hist.iterrows():
            jours = (NOW - row["status_last_updated_at"]).total_seconds() / 86400.0
            if row["status"] in STATUTS_SUCCES:
                time_decay_score += np.exp(-0.1 * jours)
        time_decay_score = round(time_decay_score / (len(hist) + 1e-9), 8)

        # ── Autres features utiles ─────────────────────────────

        # Dernier statut DLR (ex: 1=livré, 2=invalide, 4=rejeté...)
        dernier_statut = int(hist["status"].iloc[-1])

        # 1 si le dernier SMS a été livré, 0 sinon
        dernier_est_succes = 1 if dernier_statut in STATUTS_SUCCES else 0

        # Depuis combien de jours le dernier SMS a été envoyé
        jours_depuis_envoi = round((NOW - t_fin).total_seconds() / 86400.0, 2)

        # Ratios des différents types de statuts
        ratio_buffered      = round((hist["status"] == 8).mean(), 4)
        ratio_rejected      = round((hist["status"] == 4).mean(), 4)
        ratio_undeliverable = round((hist["status"] == 2).mean(), 4)

        # Ajouter une ligne pour ce contact
        lignes.append({
            "msisdn"                     : msisdn,
            "total_sms_envoyes"          : total_sms_envoyes,
            "delivery_rate"              : delivery_rate,
            "failure_rate"               : failure_rate,
            "echecs_consecutifs"         : echecs_consecutifs,
            "jours_depuis_dernier_succes": jours_depuis_dernier_succes,
            "recency_score"              : recency_score,
            "time_decay_score"           : time_decay_score,
            "dernier_statut"             : dernier_statut,
            "dernier_est_succes"         : dernier_est_succes,
            "jours_depuis_envoi"         : jours_depuis_envoi,
            "heure_envoi"                : t_debut.hour,
            "jour_semaine"               : t_debut.dayofweek,
            "ratio_buffered"             : ratio_buffered,
            "ratio_rejected"             : ratio_rejected,
            "ratio_undeliverable"        : ratio_undeliverable,
            "is_utf16"                   : int(data["encoding"] == "UTF16"),
            "cost"                       : round(np.mean(data["cost_list"]), 2),
            # Pour Cox : durée en minutes + est-ce que le dernier SMS a été livré
            "duration_cox"               : max(duree, 0.1),
            "event"                      : 1 if dernier_est_succes else 0,
        })

    df = pd.DataFrame(lignes)
    print(f"  Contacts traités : {len(df)}")
    print(f"  Features créées  : {len(lignes[0]) - 1} colonnes")
    return df


# ══════════════════════════════════════════════════════════════
# ÉTAPE 5a — COX TRAINING
# Cox calcule : dans combien de jours ce numéro sera injoignable ?
# ══════════════════════════════════════════════════════════════
def training_cox(df):
    print("\n[ÉTAPE 5a] Cox Training — Survival Analysis")
    print("  → Calcul de p_na_7j et p_na_30j pour chaque contact")

    # Colonnes utilisées par Cox
    COX_COLS = [
        "duration_cox", "event",
        "total_sms_envoyes", "delivery_rate", "failure_rate",
        "echecs_consecutifs", "jours_depuis_dernier_succes",
        "recency_score", "time_decay_score",
        "heure_envoi", "is_utf16", "cost",
    ]

    df_cox = df[COX_COLS + ["msisdn"]].dropna()
    df_cox = df_cox[df_cox["duration_cox"] > 0].copy()

    # Vérifier qu'on a des données suffisantes
    if len(df_cox) < 10 or df_cox["event"].nunique() < 2:
        print("  ⚠️  Pas assez de données → valeurs par défaut")
        df["p_na_7j"]  = 50.0
        df["p_na_30j"] = 50.0
        return df, None, 0.5

    # Entraîner Cox
    cph = CoxPHFitter(penalizer=0.1)
    cph.fit(df_cox[COX_COLS], duration_col="duration_cox", event_col="event")

    # Calculer la probabilité d'être NA dans 7 jours
    # (7 jours = 7 × 24 × 60 = 10080 minutes)
    survie_7j  = cph.predict_survival_function(df_cox[COX_COLS], times=[10080]).T
    survie_30j = cph.predict_survival_function(df_cox[COX_COLS], times=[43200]).T

    df_cox = df_cox.copy()
    df_cox["p_na_7j"]  = ((1 - survie_7j.values.flatten())  * 100).round(1)
    df_cox["p_na_30j"] = ((1 - survie_30j.values.flatten()) * 100).round(1)

    # Calcul du C-index (mesure la qualité du modèle Cox)
    c_index = concordance_index(
        df_cox["duration_cox"],
        -cph.predict_partial_hazard(df_cox[COX_COLS]),
        df_cox["event"]
    )

    # Ajouter les résultats Cox au DataFrame principal
    df = df.merge(df_cox[["msisdn", "p_na_7j", "p_na_30j"]], on="msisdn", how="left")
    df["p_na_7j"]  = df["p_na_7j"].fillna(50.0)
    df["p_na_30j"] = df["p_na_30j"].fillna(50.0)

    print(f"  ✅ Cox entraîné — C-index : {c_index:.4f}")
    print(f"  p_na_7j  moyenne : {df['p_na_7j'].mean():.1f}%")
    print(f"  p_na_30j moyenne : {df['p_na_30j'].mean():.1f}%")

    return df, cph, c_index


# ══════════════════════════════════════════════════════════════
# ÉTAPE 5b — XGBOOST TRAINING
# XGBoost apprend à classer chaque numéro en 3 catégories
# ══════════════════════════════════════════════════════════════
def training_xgboost(df):
    print("\n[ÉTAPE 5b] XGBoost Training — Classification")
    print("  → Apprentissage : Available / Suspect / NA")

    # ── Créer les labels (la réponse correcte pour chaque contact)
    # On construit la vérité terrain à partir des règles métier :
    #
    #   Available : dernier SMS livré + bon taux + pas d'échec récent
    #   NA        : dernier SMS non livré OU jamais livré
    #   Suspect   : tout le reste
    def creer_label(row):
        if row["dernier_est_succes"] == 0 or row["delivery_rate"] == 0:
            return "NA"
        if (row["dernier_est_succes"] == 1
                and row["delivery_rate"] >= 0.5
                and row["echecs_consecutifs"] == 0):
            return "Available"
        return "Suspect"

    df = df.copy()
    df["label"] = df.apply(creer_label, axis=1)

    print(f"  Labels créés :")
    for lbl, cnt in df["label"].value_counts().items():
        pct = cnt / len(df) * 100
        bar = "█" * int(pct / 3)
        print(f"    {lbl:<12} : {cnt:>4} ({pct:.1f}%)  {bar}")

    # Convertir les labels texte en nombres (XGBoost travaille avec des nombres)
    le = LabelEncoder()
    df["label_enc"] = le.fit_transform(df["label"])
    # Résultat : Available=0, NA=1, Suspect=2 (ordre alphabétique)

    # Préparer X (features) et y (labels)
    df_propre = df[FEATURE_COLS + ["label_enc"]].dropna()
    X = df_propre[FEATURE_COLS]  # ce qu'on donne au modèle
    y = df_propre["label_enc"]   # ce qu'on veut qu'il prédise

    # Équilibrer les classes
    # (il y a souvent plus de "Available" que de "NA" → on compense)
    class_counts  = np.bincount(y)
    scale_weights = class_counts.max() / (class_counts + 1e-9)
    sample_weight = np.array([scale_weights[c] for c in y])

    # Créer et entraîner XGBoost
    xgb = XGBClassifier(
        n_estimators     = 200,   # nombre d'arbres
        max_depth        = 4,     # profondeur max de chaque arbre
        learning_rate    = 0.05,  # vitesse d'apprentissage
        subsample        = 0.8,   # % de données utilisées par arbre
        colsample_bytree = 0.8,   # % de features utilisées par arbre
        eval_metric      = "mlogloss",
        random_state     = 42,
        n_jobs           = -1,
    )
    xgb.fit(X, y, sample_weight=sample_weight, verbose=False)

    print(f"  ✅ XGBoost entraîné sur {len(df_propre)} contacts")

    return xgb, le, df


# ══════════════════════════════════════════════════════════════
# ÉTAPE 6 — FUSION MODEL
# Combiner XGBoost et Cox pour calculer le score final 0-100
# ══════════════════════════════════════════════════════════════
def fusion_model(df, xgb, le):
    print("\n[ÉTAPE 6] Fusion Model")
    print("  → XGBoost + Cox → Contact Availability Score 0-100")

    X = df[FEATURE_COLS].fillna(0)

    # XGBoost donne une probabilité pour chaque classe
    probas   = xgb.predict_proba(X)
    classes  = list(le.classes_)
    idx_av   = classes.index("Available")

    # Score XGBoost = probabilité d'être Available × 100
    score_xgb = probas[:, idx_av] * 100

    # Correction Cox :
    # Si Cox dit "ce contact a 80% de risque d'être NA dans 7 jours"
    # on réduit son score XGBoost de 24%
    penalite_cox = 0.3 * (df["p_na_7j"].values / 100.0)
    score_final  = score_xgb * (1 - penalite_cox)
    score_final  = np.clip(score_final, 0, 100).round(1)

    df = df.copy()
    df["score"] = score_final

    # Classification finale selon le score
    def classifier(score):
        if score >= 70: return "Available"   # Risque faible  → Inclure
        if score >= 40: return "Suspect"     # Risque moyen   → Monitoring
        return "NA"                          # Risque élevé   → Exclure

    df["classification"] = df["score"].apply(classifier)

    print(f"  Score moyen : {score_final.mean():.1f} / 100")
    print(f"  Résultats :")
    for cls, cnt in df["classification"].value_counts().items():
        pct = cnt / len(df) * 100
        bar = "█" * int(pct / 3)
        print(f"    {cls:<12} : {cnt:>4} ({pct:.1f}%)  {bar}")

    return df


# ══════════════════════════════════════════════════════════════
# ÉTAPE 7 — EVALUATION
# Mesurer la qualité du modèle avec 3 métriques
# ══════════════════════════════════════════════════════════════
def evaluation(df, xgb, le, c_index):
    print("\n[ÉTAPE 7] Evaluation du modèle")

    X      = df[FEATURE_COLS].fillna(0)
    y_reel = df["label_enc"].dropna().astype(int)
    y_pred = xgb.predict(X)
    probas = xgb.predict_proba(X)

    # E1 — Accuracy / Precision / Recall
    acc  = accuracy_score(y_reel, y_pred)
    prec = precision_score(y_reel, y_pred, average="weighted", zero_division=0)
    rec  = recall_score(y_reel, y_pred, average="weighted", zero_division=0)
    f1   = f1_score(y_reel, y_pred, average="weighted", zero_division=0)

    print(f"\n  E1 — Accuracy / Precision / Recall")
    print(f"    Accuracy   : {acc:.4f}   (% de contacts bien classés)")
    print(f"    Precision  : {prec:.4f}  (quand il dit Available, a-t-il raison ?)")
    print(f"    Recall     : {rec:.4f}   (trouve-t-il tous les Available ?)")
    print(f"    F1-score   : {f1:.4f}")
    print(f"\n  Rapport détaillé :")
    print(classification_report(y_reel, y_pred, target_names=le.classes_, zero_division=0))

    # E2 — AUC ROC
    try:
        auc = roc_auc_score(
            pd.get_dummies(y_reel).values, probas,
            multi_class="ovr", average="weighted"
        )
        print(f"  E2 — AUC ROC : {auc:.4f}  (1.0 = parfait, 0.5 = hasard)")
    except:
        auc = 0.0
        print(f"  E2 — AUC ROC : N/A")

    # E3 — C-index Cox
    print(f"\n  E3 — C-index Survival (Cox) : {c_index:.4f}")
    print(f"    > 0.7 = bon  |  0.6-0.7 = acceptable  |  < 0.6 = faible")

    return {"accuracy": round(acc,4), "precision": round(prec,4),
            "recall": round(rec,4), "f1": round(f1,4),
            "auc_roc": round(auc,4), "c_index": round(c_index,4)}


# ══════════════════════════════════════════════════════════════
# ÉTAPE 8 — SAUVEGARDE model.pkl
# Sauvegarder tout ce dont on a besoin pour la phase Prediction
# ══════════════════════════════════════════════════════════════
def sauvegarder(xgb, le, cph, metriques):
    print("\n[ÉTAPE 8] Sauvegarde model.pkl")

    contenu = {
        "xgb_model"    : xgb,          # le modèle XGBoost entraîné
        "label_encoder": le,           # pour convertir 0/1/2 → Available/NA/Suspect
        "cox_model"    : cph,          # le modèle Cox entraîné
        "feature_cols" : FEATURE_COLS, # liste des features dans le bon ordre
        "metriques"    : metriques,    # accuracy, auc, c-index
        "trained_at"   : datetime.now().isoformat(),
    }

    with open(MODEL_PATH, "wb") as f:
        pickle.dump(contenu, f)

    print(f"  ✅ Sauvegardé → {MODEL_PATH}")
    print(f"  Taille : {os.path.getsize(MODEL_PATH) / 1024:.1f} KB")


# ══════════════════════════════════════════════════════════════
# PIPELINE PRINCIPAL
# Exécute toutes les étapes dans l'ordre
# ══════════════════════════════════════════════════════════════
def run():
    print("=" * 50)
    print("  PHASE TRAINING — DÉMARRAGE")
    print("=" * 50)

    records      = data_extraction()          # Étape 1
    contacts     = data_cleaning(records)     # Étape 2
    contacts_n   = normalisation_statuts(contacts)  # Étape 3
    df           = feature_engineering(contacts_n)  # Étape 4
    df, cph, ci  = training_cox(df)           # Étape 5a
    xgb, le, df  = training_xgboost(df)       # Étape 5b
    df           = fusion_model(df, xgb, le)  # Étape 6
    metriques    = evaluation(df, xgb, le, ci)# Étape 7
    sauvegarder(xgb, le, cph, metriques)      # Étape 8

    print("\n" + "=" * 50)
    print("  PHASE TRAINING — TERMINÉE ✅")
    print(f"  Accuracy : {metriques['accuracy']}")
    print(f"  AUC ROC  : {metriques['auc_roc']}")
    print(f"  C-index  : {metriques['c_index']}")
    print("=" * 50)


if __name__ == "__main__":
